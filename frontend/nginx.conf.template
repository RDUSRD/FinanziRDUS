# Plantilla de nginx. El entrypoint de la imagen sustituye ${API_UPSTREAM} con envsubst
# antes de arrancar, así el mismo archivo sirve en Compose (api:8000) y en Railway
# (api.railway.internal:8000). Las variables de nginx ($host, $uri, …) no se tocan:
# envsubst sólo reemplaza nombres que existan en el entorno.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # No revelar la versión de nginx.
    server_tokens off;

    # El import de JSON está limitado a 5 MB por la API (413). Acá se corta antes de llegar.
    client_max_body_size 6m;

    # Cabeceras de seguridad a nivel server.
    # OJO: nginx NO hereda los `add_header` del bloque padre dentro de un `location`
    # que define su propio `add_header`. Por eso el cacheo de los `location` de abajo
    # se hace con `expires` (que no es add_header) y estas cabeceras llegan a todas las respuestas.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    # CSP acotada: el bundle no usa CDNs ni scripts inline (verificado en el build).
    # style-src necesita 'unsafe-inline' por los atributos style="" (ancho de las barras de progreso).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    # Features del navegador que la app no usa: se deniegan explícitamente.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # No se agrega Strict-Transport-Security (HSTS): en local se sirve por HTTP plano, sin TLS.

    # El SPA habla con la API en el mismo origen: sin CORS en producción.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # Assets con hash en el nombre: cache largo.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # El HTML nunca se cachea, así el deploy nuevo se ve al instante.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
