# Copiá este archivo a .env y ajustá lo que necesites (docker compose lo lee solo).
# El .env está en .gitignore: nunca subas credenciales reales al repo.

# --- Base de datos ---
POSTGRES_USER=financirdus
POSTGRES_PASSWORD=financirdus
POSTGRES_DB=financirdus

# --- Puertos del host ---
# Dirección donde se publica la API: 127.0.0.1 (solo tu máquina) o 0.0.0.0 (toda la LAN).
# La app se usa normalmente por el puerto del frontend, que ya proxea /api.
API_BIND=127.0.0.1
API_PORT=8000
# Dirección donde se publica el frontend (nginx): 0.0.0.0 (toda la LAN) o 127.0.0.1 (solo tu máquina).
# El frontend es el puerto pensado para la LAN: proxea /api en el mismo origen, así que no hace falta exponer la API.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# --- Backend ---
# development | production
APP_ENV=production
# Zona horaria para calcular "hoy" y el mes actual (nunca se usa UTC del contenedor)
APP_TZ=America/Caracas
# Orígenes permitidos por CORS y por la comprobación anti-CSRF cuando el cliente no
# manda Sec-Fetch-Site (navegadores viejos). En desarrollo el SPA se publica en el
# 8080 aunque Vite escuche en el 5173 adentro: por eso van los dos.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Siembra datos de ejemplo al arrancar, sólo si la base está vacía (idempotente)
SEED_ON_START=true
# Con false apaga la documentación interactiva (/api/docs y /api/openapi.json); con true (por defecto) queda como está
DOCS_ENABLED=true
LOG_LEVEL=info

# --- Autenticación ---
# Clave que protege el hash de los tokens de sesión. CAMBIALA por una propia:
# con APP_ENV=production la app NO arranca si queda en el valor por defecto.
#   openssl rand -hex 32
SECRET_KEY=cambiala-por-una-clave-propia
# Credencial de arranque del único usuario. Se usa UNA sola vez, para crear el
# admin: después la contraseña vive en la base y se cambia desde la app (el
# primer ingreso obliga a cambiarla). Reiniciar con otra ADMIN_PASSWORD no la pisa.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiala-por-una-clave-propia
# Mandar la cookie de sesión sólo por HTTPS. En la LAN por HTTP TIENE que quedar
# en false (con true el navegador no la manda y no se puede entrar). En Railway va en true.
SESSION_COOKIE_SECURE=false
# Duración de la sesión: minutos de inactividad y tope duro (30 y 60 días).
SESSION_TTL_MINUTES=43200
SESSION_ABSOLUTE_TTL_MINUTES=86400
# Fuerza bruta: intentos fallidos antes del bloqueo y minutos que dura el bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
